                "size": "sm",
                "wrap": true
              },
              {
                "type": "text",
                "text": "あいち健康の森公園に新しいあそび場がオープン！",
                "size": "xs",
                "color": "#777777",
                "margin": "sm",
                "wrap": true
              }
            ]
          }
        ]
      }
    ]
  },
  "footer": {
    "type": "box",
    "layout": "vertical",
    "contents": [
      {
        "type": "button",
        "style": "primary",
        "action": {
          "type": "uri",
          "label": "夏休みのあそび場を見る",
          "uri": "https://hidagoboc.jp/asobiba-1"
        }
      }
    ]
